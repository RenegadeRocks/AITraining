# Copy this file to .env.local and fill in the values.
# In Netlify, set these as environment variables on the site.

# OpenRouter — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the default model (anthropic/claude-sonnet-4.5)
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Supabase — from Project Settings → API in https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
